# AegisSRE local development configuration.
# Copy to .env (which is gitignored). Never commit generated keys or API keys.

# Process-local HTTP settings. Override per process for direct `go run`; Compose
# supplies service-specific values and publishes the ports documented in docs/demo.md.
AEGIS_LISTEN_ADDR=:8080
AEGIS_PUBLIC_URL=http://127.0.0.1:8080

# Hard namespace boundary.
AEGIS_ALLOWED_NAMESPACE=outage-arena

# Local service graph for direct Go processes.
AEGIS_OBSERVE_MCP_URL=http://127.0.0.1:8090/mcp
AEGIS_OPERATE_MCP_URL=http://127.0.0.1:8091/mcp
AEGIS_INVESTIGATOR_URL=http://127.0.0.1:8081
AEGIS_OPERATOR_URL=http://127.0.0.1:8082

# fixture (safe local default) or kubernetes.
AEGIS_BACKEND=fixture
AEGIS_FIXTURE_PATH=./testdata/fixtures/unavailable-deployment.json

# In-cluster telemetry defaults from outage-arena. Fixture mode must not require them.
AEGIS_VICTORIA_METRICS_URL=http://vmsingle.observability.svc.cluster.local:8428
AEGIS_VICTORIA_LOGS_URL=http://vlogs.observability.svc.cluster.local:9428

# Detection and bounded evidence.
AEGIS_SCAN_INTERVAL=5s
AEGIS_VERIFICATION_COUNT=2
AEGIS_INCIDENT_COOLDOWN=1m
AEGIS_REQUEST_TIMEOUT=10s
AEGIS_EVIDENCE_BUDGET=6
AEGIS_MAX_LOG_BYTES=32768

# Safety gates. Keep both values as shown for local development.
AEGIS_DRY_RUN=true
AEGIS_ALLOW_MUTATIONS=false
AEGIS_DELEGATION_TTL=2m
AEGIS_MAX_SCALE_REPLICAS=20
AEGIS_MAX_SCALE_INCREASE=5

# Generate disposable local values with `go run ./cmd/aegissre keygen`.
# Private key: Monitor only. Public key: Operator and action MCP only.
AEGIS_DELEGATION_PRIVATE_KEY=
AEGIS_DELEGATION_PUBLIC_KEY=
AEGIS_DELEGATION_KEY_ID=aegissre-monitor-v1

# Optional Responses API Investigator. Leave all three blank for the deterministic
# heuristic. Setting the base URL requires both key and model; provider errors
# fall back to the deterministic reasoner. Never place a production key here.
AEGIS_LLM_BASE_URL=
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=

# Used only with AEGIS_BACKEND=kubernetes outside a pod.
KUBECONFIG=
