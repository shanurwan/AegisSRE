# AegisSRE local development configuration.
# Copy to .env (which is gitignored). Never commit generated keys or API keys.

# Process-local HTTP settings. Override per process for direct `go run`; Compose
# supplies service-specific values and publishes the ports documented in docs/demo.md.
AEGIS_LISTEN_ADDR=:8080
# Used for unauthenticated health/readiness/metrics only when mTLS is enabled.
AEGIS_ADMIN_LISTEN_ADDR=:9090
AEGIS_PUBLIC_URL=http://127.0.0.1:8080
AEGIS_LOG_LEVEL=info

# Hard namespace boundary.
AEGIS_ALLOWED_NAMESPACE=outage-arena

# Local service graph for direct Go processes.
AEGIS_OBSERVE_MCP_URL=http://127.0.0.1:8090/mcp
AEGIS_OPERATE_MCP_URL=http://127.0.0.1:8091/mcp
AEGIS_INVESTIGATOR_URL=http://127.0.0.1:8081
AEGIS_OPERATOR_URL=http://127.0.0.1:8082

# fixture (safe local default) or kubernetes.
AEGIS_BACKEND=fixture
AEGIS_FIXTURE_PATH=./testdata/fixtures/unavailable-deployment.json

# In-cluster telemetry defaults from outage-arena. Fixture mode must not require them.
AEGIS_VICTORIA_METRICS_URL=http://vmsingle.observability.svc.cluster.local:8428
AEGIS_VICTORIA_LOGS_URL=http://vlogs.observability.svc.cluster.local:9428
AEGIS_VICTORIA_TRACES_URL=http://vtraces.observability.svc.cluster.local:10428

# Detection and bounded evidence.
AEGIS_SCAN_INTERVAL=5s
AEGIS_VERIFICATION_COUNT=2
AEGIS_INCIDENT_COOLDOWN=1m
AEGIS_REQUEST_TIMEOUT=10s
AEGIS_EVIDENCE_BUDGET=6
AEGIS_MAX_LOG_BYTES=32768

# Safety gates. Keep both values as shown for local development.
AEGIS_DRY_RUN=true
AEGIS_ALLOW_MUTATIONS=false
# Keep live actions triggered only by cluster-state metrics until log/trace
# workload identity is proven collector-owned and authoritative.
AEGIS_ALLOW_LOG_TRACE_ACTIONS=false
AEGIS_DELEGATION_TTL=2m
AEGIS_MAX_SCALE_REPLICAS=20
AEGIS_MAX_SCALE_INCREASE=5

# Generate disposable local values with `go run ./cmd/aegissre keygen`.
# Private key: Monitor only. Public key: Operator and action MCP only.
AEGIS_DELEGATION_PRIVATE_KEY=
AEGIS_DELEGATION_PUBLIC_KEY=
AEGIS_DELEGATION_KEY_ID=aegissre-monitor-v1

# Production secret-file alternatives. Do not set the inline and file form of
# the same key together. The keyring is strict JSON and may contain overlapping
# old/new public keys during rotation.
AEGIS_DELEGATION_PRIVATE_KEY_FILE=
AEGIS_DELEGATION_PUBLIC_KEYRING_FILE=

# Strict, exact-target policy shared by Monitor, Operator, read MCP, and action
# MCP. It is mandatory for authenticated production control-plane operation.
AEGIS_WORKLOAD_POLICY_FILE=

# Workload mTLS. Local fixture development leaves this disabled. Live action
# configuration requires it, HTTPS internal URLs, a TLS 1.3 certificate with
# exactly one URI SAN, and a matching AEGIS_TLS_IDENTITY.
AEGIS_MTLS_ENABLED=false
AEGIS_TLS_CERT_FILE=
AEGIS_TLS_KEY_FILE=
AEGIS_TLS_CA_FILE=
AEGIS_TLS_IDENTITY=
AEGIS_TRUST_DOMAIN=aegissre.internal
AEGIS_SYSTEM_NAMESPACE=aegissre-system

# Durable control state. Prefer the file form in Kubernetes. PostgreSQL is
# mandatory for live Monitor/Operator/action-MCP operation and for WhatsApp
# delivery. Monitor leadership requires this lease to exceed the scan interval;
# durable Operator/action-MCP fencing requires it to exceed the request timeout
# by more than 10s, including the bounded post-cancellation persistence window.
AEGIS_DATABASE_URL=
AEGIS_DATABASE_URL_FILE=
AEGIS_DATABASE_MAX_CONNECTIONS=8
AEGIS_STATE_LEASE=1m
AEGIS_OUTBOX_POLL_INTERVAL=2s
AEGIS_OUTBOX_MAX_ATTEMPTS=8
AEGIS_INSTANCE_ID=

# W3C trace-context propagation is always installed. Configure a standard OTLP
# trace endpoint to enable export; leave blank for local no-op export.
OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=
OTEL_EXPORTER_OTLP_PROTOCOL=http/protobuf
AEGIS_TRACE_SAMPLE_RATIO=0.1

# Optional Responses API Investigator. Leave all three blank for the deterministic
# heuristic. Setting the base URL requires both key and model; provider errors
# fall back to the deterministic reasoner. Never place a production key here.
AEGIS_LLM_BASE_URL=
AEGIS_LLM_API_KEY=
AEGIS_LLM_MODEL=

# Optional Operator-only WhatsApp Cloud API delivery. Disabled by default.
# Pin a Graph API version supported by your Meta app and use an approved
# template with one body variable. Never commit the token or recipient.
AEGIS_WHATSAPP_ENABLED=false
AEGIS_WHATSAPP_GRAPH_VERSION=
AEGIS_WHATSAPP_PHONE_NUMBER_ID=
AEGIS_WHATSAPP_ACCESS_TOKEN=
AEGIS_WHATSAPP_RECIPIENT=
AEGIS_WHATSAPP_TEMPLATE=aegissre_incident_update
AEGIS_WHATSAPP_LANGUAGE=en_US

# Used only with AEGIS_BACKEND=kubernetes outside a pod.
KUBECONFIG=
